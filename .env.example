# ==============================================================================
# ai-youtube-automation — environment template
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. Every value below is a placeholder — none of them
# are real secrets.
#
# Scope note: this file holds INSTANCE-level configuration (how this
# deployment runs). CHANNEL-level configuration (niche, tone, voice, budget,
# publishing schedule, etc.) does not belong here — it will live in the
# channel configuration store described in
# docs/architecture/multi-channel-design.md, keyed by channel_id, and loaded
# dynamically by shared workflows.
# ==============================================================================

# ------------------------------------------------------------------------------
# General
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
TZ=UTC

# ------------------------------------------------------------------------------
# PostgreSQL (primary datastore — channel configs, projects, run state)
# Not exposed publicly in production; reachable only on the internal Docker
# network.
#
# Role separation (see docs/architecture/database-architecture.md#role-permission-model):
#   POSTGRES_USER/PASSWORD  bootstrap/admin superuser — used only by
#                            database/bootstrap/ to create the roles below.
#                            Never used for routine migration or app traffic.
#   MIGRATOR_*               owns the app database; applies schema
#                            migrations (DDL). Not used by any running service.
#   APP_*                    runtime role for approval-api/renderer. DML
#                            only — cannot CREATE/ALTER/DROP.
#   APP_READONLY_*           reserved for future read-only/reporting use.
#                            Not wired into any service yet.
#   N8N_DB_*                 owns the separate `n8n` database outright —
#                            n8n manages its own internal schema itself.
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_youtube_automation
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

MIGRATOR_DB_USER=migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME

APP_DB_USER=app_runtime
APP_DB_PASSWORD=CHANGE_ME

APP_READONLY_DB_USER=app_readonly
APP_READONLY_DB_PASSWORD=CHANGE_ME

N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------------------
# Redis (queues / caching / rate-limiting — introduced only where justified)
# Not exposed publicly in production.
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------------------
# n8n
# The owner account (email/password below) and the API key it's used to
# generate are created via scripts/n8n-setup-dev.sh, not n8n's setup
# wizard — see docs/architecture/workflow-runtime.md#n8n-credential-setup.
# Dev/test only; a real deployment sets its own owner credentials and
# never reuses these placeholders.
# ------------------------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=CHANGE_ME
WEBHOOK_URL=http://localhost:5678/
# regular = single instance (default for now). queue = requires an
# n8n-worker service, not implemented yet — see docker-compose.yml.
N8N_EXECUTIONS_MODE=regular

N8N_ADMIN_EMAIL=CHANGE_ME
N8N_ADMIN_PASSWORD=CHANGE_ME
# Populated by scripts/n8n-setup-dev.sh on first run — leave as CHANGE_ME
# until then. Used by the test harness to call n8n's REST/public API
# (workflow import/activation), never by any running application service.
N8N_API_KEY=CHANGE_ME

# Shared-secret header the "Step4 Config Loader Test" dev webhook requires
# (X-Dev-Test-Token) — see n8n/workflows/README.md. Not used in production;
# docker-compose.prod.yml never publishes n8n's editor/webhook UI without
# Caddy in front of it regardless.
DEV_TEST_TOKEN=CHANGE_ME

# ------------------------------------------------------------------------------
# Object storage (S3-compatible — e.g. MinIO)
# Backs the storage/ namespace: channels/{channel_id}/projects/{content_project_id}/
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_BUCKET=ai-youtube-automation

# ------------------------------------------------------------------------------
# YouTube Data API / OAuth
# Per-channel OAuth tokens are NOT stored here — each channel references a
# credential by name/id via its channel config, resolved at runtime (n8n's
# credential store). CLIENT_ID/SECRET/REDIRECT_URI are the shared Google
# Cloud OAuth client used to manually obtain an access/refresh token (via
# Google's OAuth consent screen or the OAuth Playground) for each real
# channel's credential — see
# docs/architecture/youtube-publication-pipeline.md#oauth-setup.
# ACCESS_TOKEN is that per-channel token, stored as a plain httpHeaderAuth
# credential value (NOT n8n's native oAuth2Api type — empirically, n8n's
# HTTP Request node refuses to sign any request, including calls to the
# local mock, using an oAuth2Api credential that was never connected
# through Google's interactive consent flow). Google access tokens expire
# hourly; refreshing this value periodically is a manual/external-process
# concern, not automated by this pipeline.
# ------------------------------------------------------------------------------
YOUTUBE_OAUTH_CLIENT_ID=CHANGE_ME
YOUTUBE_OAUTH_CLIENT_SECRET=CHANGE_ME
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:5678/rest/oauth2-credential/callback
YOUTUBE_OAUTH_ACCESS_TOKEN=CHANGE_ME

# ------------------------------------------------------------------------------
# External AI provider keys (shared credentials; per-channel provider
# PREFERENCE, e.g. which TTS voice or which LLM, lives in channel config —
# not here)
# ------------------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
ELEVENLABS_API_KEY=CHANGE_ME
TAVILY_API_KEY=CHANGE_ME
BRAVE_SEARCH_API_KEY=CHANGE_ME
STOCK_MEDIA_PROVIDER_API_KEY=CHANGE_ME

# ------------------------------------------------------------------------------
# Budgets & cost controls (global ceiling; per-channel budgets are configured
# in the channel config store, not here)
# ------------------------------------------------------------------------------
GLOBAL_MONTHLY_BUDGET_USD=CHANGE_ME
BUDGET_ALERT_WEBHOOK_URL=CHANGE_ME

# ------------------------------------------------------------------------------
# Oracle Cloud (deployment-time only — never used by application containers
# directly; consumed by infrastructure/oracle/ tooling)
# ------------------------------------------------------------------------------
OCI_TENANCY_OCID=CHANGE_ME
OCI_USER_OCID=CHANGE_ME
OCI_FINGERPRINT=CHANGE_ME
OCI_REGION=CHANGE_ME
OCI_COMPARTMENT_OCID=CHANGE_ME

# ------------------------------------------------------------------------------
# Reverse proxy / TLS
# ------------------------------------------------------------------------------
PUBLIC_DOMAIN=CHANGE_ME
ACME_EMAIL=CHANGE_ME

# ------------------------------------------------------------------------------
# Renderer
# Hard ceiling on simultaneous FFmpeg jobs. Keep at 1 until the Oracle
# Ampere A1 VM's headroom under real load is actually measured — rendering
# is CPU-heavy enough to starve the rest of the (free-tier) box otherwise.
# ------------------------------------------------------------------------------
RENDERER_MAX_CONCURRENCY=1
