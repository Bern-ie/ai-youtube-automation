        "jsCode": "const ctx = $('Prepare Get-Completed-Chunks Input').first().json._ctx;\nconst chunks = $json || [];\nreturn [{ json: {\n  channel_id: ctx.channel_id, content_project_id: ctx.content_project_id, version: ctx.version,\n  chunks: chunks.map((c) => ({ chunk_index: c.chunk_index, storage_path: c.storage_path })),\n  loudness_target_lufs: ctx.loudness_target_lufs || -16\n} }];"
      },
