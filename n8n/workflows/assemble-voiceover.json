    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const rec = $json.data;\nconst chunksById = {};\nfor (const c of $('Get Completed Voiceover Chunks In Order').first().json) chunksById[c.chunk_index] = c;\nconst entries = (rec.timing || []).map((t) => ({\n  start_ms: t.start_ms, end_ms: t.end_ms, text: (chunksById[t.chunk_index] || {}).text || ''\n}));\nconst ctx = $('Prepare Get-Completed-Chunks Input').first().json._ctx;\nreturn [{ json: { channel_id: ctx.channel_id, content_project_id: ctx.content_project_id, version: ctx.version, entries, _rec: rec, _ctx: ctx } }];"
      },
