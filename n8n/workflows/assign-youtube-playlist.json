{
  "name": "Assign YouTube Playlist",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "trigger-1",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-2",
              "leftValue": "={{ $json.already_applied }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-3",
      "name": "Already Applied?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json;\nreturn [{ json: { success: true, data: { already_applied: true, skipped: false }, error: null, runtime: { channel_id: b.channel_id, workflow_run_id: b.workflow_run_id, content_project_id: b.content_project_id, correlation_id: b.correlation_id ?? null } } }];"
      },
      "id": "code-4",
      "name": "Return Already Applied",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-3b",
              "leftValue": "={{ $json.playlist_id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-3b",
      "name": "Has Playlist Configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json;\nreturn [{ json: { success: true, data: { already_applied: false, skipped: true, reason: 'no playlist configured for this channel/project' }, error: null, runtime: { channel_id: b.channel_id, workflow_run_id: b.workflow_run_id, content_project_id: b.content_project_id, correlation_id: b.correlation_id ?? null } } }];"
      },
      "id": "code-3c",
      "name": "Skip Cleanly (No Playlist)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.youtube_api_base_url }}/playlistItems",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "part",
              "value": "snippet"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ snippet: { playlistId: $json.playlist_id, resourceId: { kind: 'youtube#video', videoId: $json.youtube_video_id } } }) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "http-5",
      "name": "Playlist Items Insert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "position": [
        660,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_CRED",
          "name": "youtube-oauth-history-explained"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $('When Executed by Another Workflow').first().json;\nconst res = $input.first().json;\nconst runtime = { channel_id: b.channel_id, workflow_run_id: b.workflow_run_id, content_project_id: b.content_project_id, correlation_id: b.correlation_id ?? null };\nif (res.statusCode !== 200) {\n  const retryable = res.statusCode === 429 || res.statusCode >= 500;\n  return [{ json: { success: false, data: null, error: { code: 'YOUTUBE_PLAYLIST_ASSIGNMENT_FAILED', message: `playlistItems.insert failed (HTTP ${res.statusCode}): ${JSON.stringify(res.body)}`, retryable, error_id: null }, runtime, published_video_id: b.published_video_id } }];\n}\nreturn [{ json: { success: true, channel_id: b.channel_id, runtime, published_video_id: b.published_video_id, playlist_id: b.playlist_id, last_provider_response: res.body } }];"
      },
      "id": "code-6",
      "name": "Parse Insert Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-7",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-8",
      "name": "Did Insert Succeed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        120
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "PLACEHOLDER:mark-playlist-applied.json"
        },
        "mode": "once",
        "options": {}
      },
      "id": "pg-9",
      "name": "Mark Playlist Applied",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nif (!raw.success) return [{ json: raw }];\nreturn [{ json: { success: true, data: { already_applied: false, skipped: false, playlist_applied_at: raw.data.playlist_applied_at }, error: null, runtime: raw.runtime } }];"
      },
      "id": "code-10",
      "name": "Build Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Already Applied?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Already Applied?": {
      "main": [
        [
          {
            "node": "Return Already Applied",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Has Playlist Configured?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Playlist Configured?": {
      "main": [
        [
          {
            "node": "Playlist Items Insert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip Cleanly (No Playlist)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Playlist Items Insert": {
      "main": [
        [
          {
            "node": "Parse Insert Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Insert Response": {
      "main": [
        [
          {
            "node": "Did Insert Succeed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Did Insert Succeed?": {
      "main": [
        [
          {
            "node": "Mark Playlist Applied",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Playlist Applied": {
      "main": [
        [
          {
            "node": "Build Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
