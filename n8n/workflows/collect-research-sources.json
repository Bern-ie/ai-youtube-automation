{
  "name": "Collect Research Sources",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "trigger-22",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json;\nreturn [{ json: { ctx: b, requestBody: {\n  query: b.research_question || b.topic, search_depth: 'advanced', max_results: b.max_results || 8, include_answer: false\n} } }];"
      },
      "id": "code-23",
      "name": "Prepare Tavily Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.tavily.com/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "http-24",
      "name": "Call Tavily",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_TAVILY",
          "name": "tavily-api"
        }
      },
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-25",
              "leftValue": "={{ $json.results !== undefined && Array.isArray($json.results) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-26",
      "name": "Did Tavily Succeed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepare Tavily Request').first().json.ctx;\nreturn [{ json: { ctx, query: ctx.research_question || ctx.topic } }];"
      },
      "id": "code-27",
      "name": "Prepare Brave Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.search.brave.com/res/v1/web/search",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.query }}"
            },
            {
              "name": "count",
              "value": "8"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "http-28",
      "name": "Call Brave Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_BRAVE",
          "name": "brave-search-api"
        }
      },
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepare Brave Request').first().json.ctx;\nconst resp = $input.first().json;\nconst items = (resp.web && resp.web.results) || [];\nconst results = items.map((r) => ({\n  url: r.url, title: r.title, publisher: (r.profile && r.profile.name) || null, author: null,\n  published_at: r.page_age || null, excerpt: r.description || null, provider_relevance: null, raw_metadata: {}\n}));\nreturn [{ json: { ctx, provider: 'brave', results } }];"
      },
      "id": "code-29",
      "name": "Normalize Brave Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepare Tavily Request').first().json.ctx;\nconst resp = $input.first().json;\nconst results = (resp.results || []).map((r) => ({\n  url: r.url, title: r.title, publisher: null, author: null, published_at: r.published_date || null,\n  excerpt: r.content || null, provider_relevance: (typeof r.score === 'number' ? r.score : null), raw_metadata: {}\n}));\nreturn [{ json: { ctx, provider: 'tavily', results } }];"
      },
      "id": "code-30",
      "name": "Normalize Tavily Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: $input.first().json }];"
      },
      "id": "code-31",
      "name": "Merge Normalized Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $json; const ctx = j.ctx;\nreturn [{ json: { channel_id: ctx.channel_id, content_project_id: ctx.content_project_id, provider: j.provider, service_type: 'search', metric: 'queries', quantity: 1, unit: 'request', metadata: {} } }];"
      },
      "id": "code-38",
      "name": "Prepare Search Usage Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
