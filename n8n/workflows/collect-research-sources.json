      "id": "exec-39",
      "name": "Record Search Usage",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2200,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $('Merge Normalized Results').first().json; const ctx = j.ctx;\n// Tavily \"advanced\" search-depth: $0.008/credit, ~1 credit/query at this\n// depth (see docs/architecture/research-pipeline.md#provider-architecture\n// for the documented estimate + citation). Brave: free tier assumed $0.\nconst perQueryCost = j.provider === 'tavily' ? 0.008 : 0;\nreturn [{ json: {\n  channel_id: ctx.channel_id, content_project_id: ctx.content_project_id, workflow_run_id: ctx.workflow_run_id, workflow_step_id: null,\n  provider: j.provider, service_type: 'search', model: null, quantity: 1, unit: 'request', unit_price_usd: perQueryCost,\n  total_cost_usd: perQueryCost, provider_request_id: null, estimated: true, metadata: {}\n} }];"
      },
      "id": "code-40",
      "name": "Prepare Search Cost Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "PLACEHOLDER:record-cost-event.json"
        },
        "mode": "once",
        "options": {}
      },
      "id": "exec-41",
      "name": "Record Search Cost",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2640,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $('Merge Normalized Results').first().json; const ctx = j.ctx;\nreturn [{ json: {\n  channel_id: ctx.channel_id, workflow_run_id: ctx.workflow_run_id, content_project_id: ctx.content_project_id,\n  sources: j.results, search_provider: j.provider, research_question: ctx.research_question || ctx.topic\n} }];"
      },
