      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Merge Normalized Results').first().json.ctx;\nreturn [{ json: {\n  success: false, data: null,\n  error: { code: 'INSUFFICIENT_SOURCES', message: 'search provider returned zero usable results for this research question', retryable: true, error_id: null },\n  runtime: { channel_id: ctx.channel_id, workflow_run_id: ctx.workflow_run_id, content_project_id: ctx.content_project_id, correlation_id: null }\n} }];"
      },
