{
  "name": "Compute Final Video Checksum",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "trigger-1",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://renderer:3000/storage/verify-checksum",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel_id: $json.channel_id, content_project_id: $json.content_project_id, storage_path: $json.storage_path, expected_checksum: $json.expected_checksum }) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "http-2",
      "name": "Verify Checksum",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $('When Executed by Another Workflow').first().json;\nconst res = $input.first().json;\nconst runtime = { channel_id: b.channel_id, workflow_run_id: b.workflow_run_id, content_project_id: b.content_project_id, correlation_id: b.correlation_id ?? null };\nif (res.statusCode !== 200) {\n  return [{ json: { success: false, data: null, error: { code: 'YOUTUBE_PREFLIGHT_FAILED', message: `checksum verification failed: ${JSON.stringify(res.body)}`, retryable: false, error_id: null }, runtime } }];\n}\nreturn [{ json: { success: true, data: { actual_checksum: res.body.actual_checksum, size_bytes: res.body.size_bytes, matches: res.body.matches }, error: null, runtime } }];"
      },
      "id": "code-3",
      "name": "Build Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Verify Checksum",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify Checksum": {
      "main": [
        [
          {
            "node": "Build Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
