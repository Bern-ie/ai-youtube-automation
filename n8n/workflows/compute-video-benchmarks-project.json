          }
        ],
        [
          {
            "node": "Build Benchmark Failure Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Benchmark Failure Response": {
      "main": []
    },
    "Prepare Generate-Strategy-Insights Input": {
      "main": [
        [
          {
            "node": "Generate Strategy Insights",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Strategy Insights": {
      "main": [
        [
          {
            "node": "Build Compute-Benchmarks-Project Success Response",
