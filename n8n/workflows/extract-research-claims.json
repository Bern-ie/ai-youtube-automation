    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepare Get-Prompt Input').first().json._ctx;\nreturn [{ json: {\n  success: false, data: null,\n  error: { code: 'CLAIM_EXTRACTION_FAILED', message: 'no sources are available for this project -- collect_sources must run first', retryable: false, error_id: null },\n  runtime: { channel_id: ctx.channel_id, workflow_run_id: ctx.workflow_run_id, content_project_id: ctx.content_project_id, correlation_id: null }\n} }];"
      },
      "id": "code-58",
      "name": "Build No-Sources Failure Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        900
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prompt = $('Get Channel Prompt').first().json.data;\nconst ctx = $('Prepare Get-Prompt Input').first().json._ctx;\nconst sources = $json.sources;\nconst model = (prompt.model_compatibility && prompt.model_compatibility[0]) || 'claude-opus-4-8';\n// Excerpts only -- never the full article -- per the copyright/robots\n// guidance in docs/architecture/research-pipeline.md#robots--copyright--content-handling.\nconst trimmedSources = sources.map((s) => ({\n  source_id: s.source_id, title: s.title, publisher: s.publisher,\n  excerpt: (s.relevant_excerpt || '').slice(0, 2000)\n}));\nconst userPayload = {\n  primary_question: ctx.primary_question, subquestions: ctx.subquestions || [], sources: trimmedSources\n};\nconst schema = {\"title\":\"Claim Extraction Output\",\"description\":\"Structured output of the claim-extraction LLM call, validated before being passed to create_research_claims_batch(). Every source_id cited here must be a source_id already returned by collect_research_sources() for this project — invented IDs are rejected by the research_claim_sources foreign key, not trusted from the LLM. See docs/architecture/research-pipeline.md#claim-extraction.\",\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"claims\"],\"properties\":{\"claims\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"claim_text\",\"classification\",\"confidence\",\"time_sensitive\"],\"properties\":{\"claim_text\":{\"type\":\"string\",\"description\":\"One atomic, independently verifiable claim — not a vague generalization.\"},\"classification\":{\"type\":\"string\",\"enum\":[\"verified_fact\",\"likely_fact\",\"opinion\",\"inference\",\"unverified_claim\",\"time_sensitive_claim\"]},\"confidence\":{\"type\":\"number\"},\"time_sensitive\":{\"type\":\"boolean\"},\"supporting_source_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"contradicting_source_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"contextualizing_source_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}}}}}}};\nreturn [{ json: {\n  ctx, model,\n  requestBody: {\n    model, max_tokens: 8192,\n    system: prompt.content,\n    messages: [{ role: 'user', content: JSON.stringify(userPayload) }],\n    output_config: { format: { type: 'json_schema', schema } }\n  }\n} }];"
      },
