    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $('Parse Claims Response').first().json; const ctx = j.ctx;\n// Pricing: $5.00 / 1M input tokens, $25.00 / 1M output tokens.\n// One multiply-and-divide per call, not a compounding ledger -- every\n// persistent aggregate (SUM() over cost_events.total_cost_usd, a NUMERIC\n// column) happens in SQL, never in JS. See\n// docs/architecture/research-pipeline.md#cost-tracking.\nconst inputTokens = j.usage.input_tokens || 0;\nconst outputTokens = j.usage.output_tokens || 0;\nconst inputCost = (inputTokens / 1000000) * 5;\nconst outputCost = (outputTokens / 1000000) * 25;\nconst totalCost = Math.round((inputCost + outputCost) * 1000000) / 1000000;\nreturn [{ json: {\n  channel_id: ctx.channel_id, content_project_id: ctx.content_project_id, workflow_run_id: ctx.workflow_run_id, workflow_step_id: null,\n  provider: 'anthropic', service_type: 'llm', model: j.model,\n  quantity: inputTokens + outputTokens, unit: 'token', unit_price_usd: null,\n  total_cost_usd: totalCost, provider_request_id: j.provider_request_id, estimated: false, metadata: {}\n} }];"
      },
