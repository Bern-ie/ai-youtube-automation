    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resp = $input.first().json;\nconst ctx = $('Prepare Anthropic Request').first().json.ctx;\nconst model = $('Prepare Anthropic Request').first().json.model;\nconst textBlock = (resp.content || []).find((b) => b.type === 'text');\nlet claims = null; let parse_failed = true;\nif (textBlock) { try { claims = JSON.parse(textBlock.text).claims; parse_failed = !Array.isArray(claims); } catch (e) { parse_failed = true; } }\nreturn [{ json: { parse_failed, ctx, model, claims, usage: resp.usage || {}, provider_request_id: resp.id || null } }];"
      },
