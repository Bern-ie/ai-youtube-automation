        "jsCode": "const ctx = $('Normalize Loop Input').first().json;\nconst claimed = $json.data;\nconst text = claimed.pronunciation_text || claimed.text;\nconst wordCount = text.split(/\\s+/).filter(Boolean).length;\nconst WPM = 155;\nconst estimatedSeconds = Math.max(0.5, (wordCount / WPM) * 60);\nreturn [{ json: {\n  channel_id: ctx.channel_id, workflow_run_id: ctx.workflow_run_id, content_project_id: ctx.content_project_id,\n  voiceover_id: ctx.voiceover_id, provider: ctx.provider, model: ctx.model, voice_reference: ctx.voice_reference,\n  voice_settings: ctx.voice_settings, version: ctx.version,\n  chunk_id: claimed.chunk_id, chunk_index: claimed.chunk_index, section_id: claimed.section_id, unit_index: claimed.unit_index,\n  text: claimed.text, pronunciation_text: claimed.pronunciation_text, attempt: claimed.attempt,\n  estimated_duration_seconds: estimatedSeconds,\n  _loop: { _iteration: ctx._iteration, _max_iterations: ctx._max_iterations }\n} }];"
      },
