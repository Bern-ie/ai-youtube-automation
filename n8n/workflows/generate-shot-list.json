    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const p = $('Parse Response').first().json;\nconst orig = $('Prepare Anthropic Request').first().json.requestBody;\nconst repairMessages = orig.messages.concat([\n  { role: 'assistant', content: p._raw_text || '' },\n  { role: 'user', content: 'Your previous response was not valid JSON matching the required schema. Return ONLY the corrected JSON array matching the schema -- no prose, no markdown fences.' }\n]);\nreturn [{ json: { ctx: p.ctx, model: p.model, requestBody: { ...orig, messages: repairMessages } } }];"
      },
