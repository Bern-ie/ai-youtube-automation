    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prompt = $json.data;\nconst ctx = $('Prepare Get-Prompt Input').first().json._ctx;\nconst model = (prompt.model_compatibility && prompt.model_compatibility[0]) || 'claude-opus-4-8';\nconst userPayload = {\n  script_content: ctx.script_content, narration_timing: ctx.narration_timing, target_duration_seconds: ctx.target_duration_seconds,\n  channel: { visual_style: ctx.style && ctx.style.visual_style, visual_policy: ctx.style && ctx.style.visual_policy, branding: ctx.branding, video_format: ctx.style && ctx.style.video_format }\n};\nconst schema = {\"title\":\"Visual Shot List\",\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"section_id\",\"unit_index_start\",\"unit_index_end\",\"visual_type\"],\"properties\":{\"section_id\":{\"type\":\"string\",\"minLength\":1},\"unit_index_start\":{\"type\":\"integer\",\"minimum\":0},\"unit_index_end\":{\"type\":\"integer\",\"minimum\":0},\"visual_type\":{\"type\":\"string\",\"enum\":[\"stock_video\",\"stock_image\",\"generated_image\",\"generated_video\",\"screenshot\",\"chart\",\"map\",\"motion_graphic\",\"text_animation\",\"public_domain_archive\",\"brand_asset\"]},\"visual_purpose\":{\"type\":[\"string\",\"null\"]},\"search_query\":{\"type\":[\"string\",\"null\"]},\"generation_prompt\":{\"type\":[\"string\",\"null\"]},\"overlay_text\":{\"type\":[\"string\",\"null\"]},\"motion_plan\":{\"type\":\"object\"},\"transition_in\":{\"type\":\"string\",\"enum\":[\"cut\",\"dissolve\",\"fade\",\"zoom\",\"match_cut\",\"none\"]},\"transition_out\":{\"type\":\"string\",\"enum\":[\"cut\",\"dissolve\",\"fade\",\"zoom\",\"match_cut\",\"none\"]},\"source_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"format\":\"uuid\"}},\"claim_ids\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"format\":\"uuid\"}},\"reuse_allowed\":{\"type\":\"boolean\"},\"priority\":{\"type\":\"integer\"},\"fallback_strategy\":{\"type\":\"array\",\"items\":{\"type\":\"string\",\"enum\":[\"stock_video\",\"stock_image\",\"generated_image\",\"generated_video\",\"screenshot\",\"chart\",\"map\",\"motion_graphic\",\"text_animation\",\"public_domain_archive\",\"brand_asset\"]},\"minItems\":1}}}};\nreturn [{ json: {\n  ctx, model, prompt_version_id: prompt.prompt_version_id,\n  requestBody: {\n    model, max_tokens: 8192,\n    system: prompt.content,\n    messages: [{ role: 'user', content: JSON.stringify(userPayload) }],\n    output_config: { format: { type: 'json_schema', schema } }\n  }\n} }];"
      },
