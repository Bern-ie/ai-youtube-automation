      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prompt = $json.data;\nconst ctx = $('Prepare Get-Prompt Input').first().json._ctx;\nconst model = (prompt.model_compatibility && prompt.model_compatibility[0]) || 'claude-opus-4-8';\nconst userPayload = {\n  topic: ctx.topic, script_content: ctx.script_content, final_video: { duration_seconds: ctx.final_video && ctx.final_video.duration_seconds },\n  available_assets: ctx.available_assets, channel: { thumbnail_rules: ctx.thumbnail_rules, brand_colors: ctx.brand_colors, visual_style: ctx.visual_style, fonts: { primary: ctx.font_primary, secondary: ctx.font_secondary }, logo_asset_path: ctx.logo_asset_path, publication_policy: ctx.publication_policy }\n};\nconst schema = {\"title\":\"Thumbnail Concepts\",\"description\":\"Structured output of the thumbnail-concepts LLM call, before persist_thumbnail_concepts(). Persisted BEFORE any rendering/generation call \u2014 see docs/architecture/publication-package-pipeline.md#thumbnail-concepts. Top-level array must contain at least 3 entries.\",\"type\":\"array\",\"minItems\":3,\"items\":{\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"visual_idea\",\"source_asset_strategy\"],\"properties\":{\"visual_idea\":{\"type\":\"string\",\"minLength\":1},\"source_asset_strategy\":{\"type\":\"string\",\"enum\":[\"generated_image\",\"existing_asset\",\"video_frame\",\"composite\",\"brand_template\"]},\"source_asset_id\":{\"type\":[\"string\",\"null\"],\"format\":\"uuid\",\"description\":\"Required when source_asset_strategy is existing_asset/composite \u2014 an asset_id from the already-approved visual shot list, never invented.\"},\"source_frame_timestamp_ms\":{\"type\":[\"integer\",\"null\"],\"minimum\":0,\"description\":\"Required when source_asset_strategy is video_frame \u2014 a timestamp within the final video's actual duration.\"},\"overlay_text\":{\"type\":[\"string\",\"null\"],\"description\":\"0-5 words recommended. Never a duplicate of the full title.\"},\"focal_subject\":{\"type\":[\"string\",\"null\"]},\"composition\":{\"type\":[\"string\",\"null\"]},\"emotional_angle\":{\"type\":[\"string\",\"null\"]},\"branding_notes\":{\"type\":[\"string\",\"null\"]},\"generation_prompt\":{\"type\":[\"string\",\"null\"],\"description\":\"Required when source_asset_strategy is generated_image, null otherwise.\"},\"factual_risk_notes\":{\"type\":[\"string\",\"null\"],\"description\":\"Null if no factual-accuracy risk. Otherwise describes exactly what a real-person/real-event depiction shows and why it is not deceptive \u2014 see docs/architecture/publication-package-pipeline.md#real-people-events.\"}}}};\nreturn [{ json: {\n  ctx, model,\n  requestBody: { model, max_tokens: 8192, system: prompt.content, messages: [{ role: 'user', content: JSON.stringify(userPayload) }], output_config: { format: { type: 'json_schema', schema } } }\n} }];"
      },
