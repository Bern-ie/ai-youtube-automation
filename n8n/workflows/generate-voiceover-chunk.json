    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const renderer = $('Call Renderer: Validate And Store').first().json;\nconst ctx = $('Prepare Renderer Validate Input').first().json.ctx;\nconst costInput = $('Prepare Cost Event').first().json;\nreturn [{ json: {\n  channel_id: ctx.channel_id, chunk_id: ctx.chunk_id, storage_path: renderer.storage_path, checksum: renderer.checksum,\n  duration_seconds: renderer.duration_seconds, provider: 'elevenlabs', model: ctx.model, voice_reference: ctx.voice_reference,\n  provider_request_id: null, usage_quantity: ctx.pronunciation_text.length, usage_unit: 'characters', cost_usd: costInput._cost,\n  metadata: { leading_silence_ms: renderer.leading_silence_ms, trailing_silence_ms: renderer.trailing_silence_ms }\n} }];"
      },
