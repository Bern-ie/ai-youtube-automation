    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const renderer = $input.first().json;\nconst ctx = $('Prepare Renderer Validate Input').first().json.ctx;\nreturn [{ json: {\n  channel_id: ctx.channel_id, chunk_id: ctx.chunk_id, workflow_run_id: ctx.workflow_run_id, error_code: 'VOICEOVER_CHUNK_INVALID',\n  message: 'Renderer flagged the generated chunk as invalid: ' + JSON.stringify(renderer.issues || renderer.error || []),\n  sanitized_details: { issues: renderer.issues || [] }, retryable: true, provider: 'elevenlabs', provider_request_id: null, _ctx: ctx\n} }];"
      },
      "id": "code-25",
      "name": "Build Invalid-Chunk Failure Info",
