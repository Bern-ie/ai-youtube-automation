        "jsCode": "const ctx = $('Build Invalid-Chunk Failure Info').first().json._ctx;\nreturn [{ json: {\n  success: false, data: null,\n  error: { code: 'VOICEOVER_CHUNK_INVALID', message: 'Generated audio failed renderer validation for chunk ' + ctx.chunk_id, retryable: true, error_id: null },\n  runtime: { channel_id: ctx.channel_id, workflow_run_id: ctx.workflow_run_id, content_project_id: ctx.content_project_id, correlation_id: null }\n} }];"
