{
  "name": "Generate Voiceover Chunk",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "trigger-13",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json;\nconst settings = b.voice_settings || {};\nreturn [{ json: {\n  ctx: b,\n  requestBody: {\n    text: b.pronunciation_text,\n    model_id: b.model,\n    voice_settings: {\n      stability: settings.stability ?? 0.5, similarity_boost: settings.similarity_boost ?? 0.75,\n      style: settings.style ?? 0, use_speaker_boost: settings.use_speaker_boost ?? true\n    }\n  }\n} }];"
      },
      "id": "code-14",
      "name": "Prepare TTS Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ \"https://api.elevenlabs.io/v1/text-to-speech/\" + $json.ctx.voice_reference }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.requestBody) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "responseFormat": "file",
              "neverError": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "http-15",
      "name": "Call ElevenLabs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_ELEVENLABS",
          "name": "elevenlabs-api"
        }
      },
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-16",
              "leftValue": "={{ $json['content-type'] !== undefined || $binary.data !== undefined }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-17",
      "name": "Did TTS Call Succeed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resp = $input.first().json;\nconst ctx = $('Prepare TTS Request').first().json.ctx;\nconst statusCode = resp.statusCode || resp.status || 0;\nconst retryable = !(statusCode === 401 || statusCode === 403 || statusCode === 400 || statusCode === 422);\nreturn [{ json: {\n  channel_id: ctx.channel_id, chunk_id: ctx.chunk_id, workflow_run_id: ctx.workflow_run_id, error_code: 'VOICEOVER_CHUNK_GENERATION_FAILED',\n  message: 'ElevenLabs TTS call failed (status ' + statusCode + ')', sanitized_details: { status_code: statusCode },\n  retryable, provider: 'elevenlabs', provider_request_id: null, _ctx: ctx\n} }];"
      },
      "id": "code-18",
      "name": "Build TTS Failure Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        900
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "PLACEHOLDER:mark-voiceover-chunk-failed.json"
        },
        "mode": "once",
        "options": {}
      },
      "id": "exec-19",
      "name": "Mark Voiceover Chunk Failed (TTS)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Build TTS Failure Info').first().json._ctx;\nreturn [{ json: {\n  success: false, data: null,\n  error: { code: 'VOICEOVER_CHUNK_GENERATION_FAILED', message: 'TTS provider call failed for chunk ' + ctx.chunk_id, retryable: true, error_id: null },\n  runtime: { channel_id: ctx.channel_id, workflow_run_id: ctx.workflow_run_id, content_project_id: ctx.content_project_id, correlation_id: null }\n} }];"
      },
      "id": "code-20",
      "name": "Build TTS Failure Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        900
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepare TTS Request').first().json.ctx;\n// No URLSearchParams here -- n8n's Code node sandbox does not expose it\n// (the same class of gap as no require('crypto'), see prepare-voiceover-chunks.json).\nconst params = {\n  channel_id: ctx.channel_id, content_project_id: ctx.content_project_id, version: String(ctx.version),\n  chunk_index: String(ctx.chunk_index), expected_min_duration_seconds: String(ctx.estimated_duration_seconds),\n  expected_max_duration_seconds: String(ctx.estimated_duration_seconds),\n};\nconst qs = Object.keys(params).map((k) => encodeURIComponent(k) + '=' + encodeURIComponent(params[k])).join('&');\nreturn [{ json: { url: 'http://renderer:3000/audio/chunks/validate-and-store?' + qs, ctx } }];"
      },
      "id": "code-21",
      "name": "Prepare Renderer Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendBody": true,
        "specifyBody": "raw",
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-22",
      "name": "Call Renderer: Validate And Store",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
