    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepare Renderer Validate Input').first().json.ctx;\n// ElevenLabs pricing estimate: ~$0.30 per 1,000 characters at a mid-tier\n// plan -- documented estimate, see docs/architecture/voiceover-pipeline.md#tts-provider-architecture.\nconst PRICE_PER_1K_CHARS = 0.30;\nconst chars = ctx.pronunciation_text.length;\nconst cost = Math.round((chars / 1000) * PRICE_PER_1K_CHARS * 1000000) / 1000000;\nreturn [{ json: {\n  channel_id: ctx.channel_id, content_project_id: ctx.content_project_id, workflow_run_id: ctx.workflow_run_id, workflow_step_id: null,\n  provider: 'elevenlabs', service_type: 'tts', model: ctx.model, quantity: chars, unit: 'characters', unit_price_usd: PRICE_PER_1K_CHARS / 1000,\n  total_cost_usd: cost, provider_request_id: null, estimated: true, metadata: {}, _cost: cost\n} }];"
      },
      "id": "code-30",
      "name": "Prepare Cost Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3300,
        0
