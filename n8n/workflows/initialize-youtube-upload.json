{
  "name": "Initialize YouTube Upload",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "trigger-1",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-2",
              "leftValue": "={{ $json.resume_upload_session_uri }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-3",
      "name": "Already Initialized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json;\nreturn [{ json: { success: true, data: { upload_session_uri: b.resume_upload_session_uri, total_bytes: b.total_bytes, already_initialized: true }, error: null, runtime: { channel_id: b.channel_id, workflow_run_id: b.workflow_run_id, content_project_id: b.content_project_id, correlation_id: b.correlation_id ?? null } } }];"
      },
      "id": "code-4",
      "name": "Return Existing Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.youtube_upload_api_base_url }}/videos",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "uploadType",
              "value": "resumable"
            },
            {
              "name": "part",
              "value": "snippet,status"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Upload-Content-Type",
              "value": "video/mp4"
            },
            {
              "name": "X-Upload-Content-Length",
              "value": "={{ $json.total_bytes }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ snippet: { title: $json.title, description: $json.description, tags: $json.tags, categoryId: $json.category_id }, status: { privacyStatus: 'private', selfDeclaredMadeForKids: $json.made_for_kids } }) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "http-5",
      "name": "Init Resumable Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "position": [
        440,
        120
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_CRED",
          "name": "youtube-oauth-history-explained"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $('When Executed by Another Workflow').first().json;\nconst res = $input.first().json;\nconst runtime = { channel_id: b.channel_id, workflow_run_id: b.workflow_run_id, content_project_id: b.content_project_id, correlation_id: b.correlation_id ?? null };\nif (res.statusCode !== 200) {\n  const retryable = res.statusCode === 429 || res.statusCode >= 500;\n  return [{ json: { success: false, data: null, error: { code: 'YOUTUBE_UPLOAD_FAILED', message: `resumable upload init failed (HTTP ${res.statusCode}): ${JSON.stringify(res.body)}`, retryable, error_id: null }, runtime, published_video_id: b.published_video_id, _provider_response: res.body } }];\n}\nconst location = (res.headers['location'] || res.headers['Location']);\nif (!location) {\n  return [{ json: { success: false, data: null, error: { code: 'YOUTUBE_UPLOAD_FAILED', message: 'resumable upload init returned no Location header', retryable: true, error_id: null }, runtime, published_video_id: b.published_video_id, _provider_response: res.body } }];\n}\nreturn [{ json: { success: true, channel_id: runtime.channel_id, upload_session_uri: location, total_bytes: b.total_bytes, published_video_id: b.published_video_id, runtime, _provider_response: res.body } }];"
      },
      "id": "code-6",
      "name": "Parse Init Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-7",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-8",
      "name": "Did Init Succeed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        120
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "PLACEHOLDER:mark-upload-initialized.json"
        },
        "mode": "once",
        "options": {}
      },
      "id": "pg-9",
      "name": "Mark Upload Initialized",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const raw = $input.first().json;\nif (!raw.success) return [{ json: raw }];\nreturn [{ json: { success: true, data: { upload_session_uri: $('Parse Init Response').first().json.upload_session_uri, total_bytes: $('Parse Init Response').first().json.total_bytes, already_initialized: false }, error: null, runtime: raw.runtime } }];"
      },
      "id": "code-10",
      "name": "Build Success Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": {
      "main": [
        [
          {
            "node": "Already Initialized?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Already Initialized?": {
      "main": [
        [
          {
            "node": "Return Existing Session",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Init Resumable Upload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Init Resumable Upload": {
      "main": [
        [
          {
            "node": "Parse Init Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Init Response": {
      "main": [
        [
          {
            "node": "Did Init Succeed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Did Init Succeed?": {
      "main": [
        [
          {
            "node": "Mark Upload Initialized",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Build Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Upload Initialized": {
      "main": [
        [
          {
            "node": "Build Success Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
