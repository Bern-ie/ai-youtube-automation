    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Bounded polling: 4 attempts total (~6s of waiting), matching the\n// brief's \"do not poll forever\" -- if YouTube is still transcoding\n// after this, we PRESERVE the recorded video id/upload state as\n// 'processing' and let a later recheck resolve it (never re-upload).\nconst b = $('When Executed by Another Workflow').first().json;\nconst body = $input.first().json || {};\nconst item = (body.items || [])[0];\nconst status = item?.processingDetails?.processingStatus || null;\nreturn [{ json: { processing_status: status, timed_out: status === 'processing' || status === null, runtime: { channel_id: b.channel_id, workflow_run_id: b.workflow_run_id, content_project_id: b.content_project_id, correlation_id: b.correlation_id ?? null } } }];"
      },
      "id": "code-18",
      "name": "Parse Attempt 4 (Final)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        600
      ]
    },
