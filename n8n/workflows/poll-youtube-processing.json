        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nreturn [{ json: { success: true, data: { processing_status: r.processing_status, timed_out: r.timed_out }, error: null, runtime: r.runtime } }];"
      },
      "id": "code-19",
      "name": "Build Result",
