        "jsCode": "// Checkpoint offsets mirror schedule_analytics_checkpoints' own\n// definitions (database/migrations/20260722290000_youtube_analytics_pipeline_schema.sql)\n// -- centralized here once rather than scattered across call sites.\nconst CHECKPOINT_OFFSET_SECONDS = { '1h': 3600, '24h': 86400, '72h': 259200, '7d': 604800, '28d': 2419200 };\nconst b = $('When Executed by Another Workflow').first().json;\nconst row = $input.first().json;\nconst publishedAt = row.published_at ? new Date(row.published_at) : new Date();\nconst offsetMs = (CHECKPOINT_OFFSET_SECONDS[b.checkpoint] || 0) * 1000;\nconst intended = new Date(publishedAt.getTime() + offsetMs);\nreturn [{ json: {\n  channel_id: b.channel_id, job_id: b.job_id, published_video_id: b.published_video_id, checkpoint: b.checkpoint,\n  youtube_video_id: b.youtube_video_id, privacy_status: b.privacy_status, youtube_credential_reference: b.youtube_credential_reference,\n  youtube_credential_status: row.credential_status || null, published_at: publishedAt.toISOString(), intended_checkpoint_at: intended.toISOString(),\n  _mock_simulate: b._mock_simulate || null\n} }];"
