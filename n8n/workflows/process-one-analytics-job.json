      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Core metrics batched in ONE call (never one call per metric) --\n// see docs/architecture/analytics-strategy-pipeline.md#quota-tracking.\nconst ctx = $('Merge Resolved Credential').first().json;\nconst CORE_METRICS = ['views','estimatedMinutesWatched','averageViewDuration','averageViewPercentageRatio','subscribersGained','subscribersLost','likes','comments','shares','impressions','impressionsCtr'];\nconst start = new Date(ctx.published_at).toISOString().slice(0, 10);\nconst end = new Date().toISOString().slice(0, 10);\nreturn [{ json: { ...ctx, _reports_url: ctx.youtube_analytics_api_base_url + '/reports', _q_metrics: CORE_METRICS.join(','), _q_start: start, _q_end: end, _q_filters: 'video==' + ctx.youtube_video_id } }];"
