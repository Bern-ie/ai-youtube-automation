    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepare Core Metrics Call').first().json;\nconst res = $input.first().json;\nif (res.statusCode !== 200) {\n  const retryable = res.statusCode === 429 || res.statusCode >= 500;\n  const code = res.statusCode === 401 ? 'ANALYTICS_NOT_AUTHORIZED' : (res.statusCode === 403 ? 'ANALYTICS_QUOTA_EXCEEDED' : 'ANALYTICS_COLLECTION_FAILED');\n  return [{ json: { _failed: true, channel_id: ctx.channel_id, job_id: ctx.job_id, error_code: code, message: 'core metrics call failed (HTTP ' + res.statusCode + '): ' + JSON.stringify(res.body), retryable, sanitized_details: {}, provider: 'youtube', _ctx: ctx } }];\n}\nconst body = res.body || {};\nconst headers = (body.columnHeaders || []).map((h) => h.name);\nconst row = (body.rows && body.rows[0]) || null;\nconst FIELD_MAP = {\n  views: 'views', estimatedMinutesWatched: 'watch_time_minutes', averageViewDuration: 'average_view_duration_seconds',\n  averageViewPercentageRatio: 'average_percentage_viewed_ratio', subscribersGained: 'subscribers_gained', subscribersLost: 'subscribers_lost',\n  likes: 'likes', comments: 'comments', shares: 'shares', impressions: 'impressions', impressionsCtr: 'ctr_ratio',\n};\nconst metrics = { returning_viewers: null, unique_viewers: null, monetized_playbacks: null, estimated_revenue_usd: null };\nconst availability = { returning_viewers: 'not_applicable', unique_viewers: 'not_applicable', monetized_playbacks: 'not_applicable', estimated_revenue_usd: 'not_authorized' };\nheaders.forEach((h, i) => {\n  const key = FIELD_MAP[h];\n  if (!key) return;\n  const val = row ? row[i] : undefined;\n  if (val === undefined || val === null) { metrics[key] = null; availability[key] = 'not_yet_processed'; }\n  else { metrics[key] = val; availability[key] = 'available'; }\n});\nconst allAvailable = Object.values(availability).filter((v) => v !== 'not_applicable' && v !== 'not_authorized').every((v) => v === 'available');\nconst noneAvailable = !row;\nconst snapshotStatus = noneAvailable ? 'pending_data' : (allAvailable ? 'complete' : 'partial');\nreturn [{ json: { _failed: false, ctx, metrics, availability, snapshot_status: snapshotStatus } }];"
      },
