    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const ctx = $('Prepare Videos.List Call').first().json;\nconst res = $input.first().json;\nif (res.statusCode !== 200) {\n  return [{ json: { channel_id: ctx.channel_id, published_video_id: ctx.published_video_id, workflow_run_id: ctx.workflow_run_id, youtube_state: null } }];\n}\nconst items = (res.body && res.body.items) || [];\nif (items.length === 0) {\n  return [{ json: { channel_id: ctx.channel_id, published_video_id: ctx.published_video_id, workflow_run_id: ctx.workflow_run_id, youtube_state: { exists: false } } }];\n}\nconst v = items[0];\nreturn [{ json: { channel_id: ctx.channel_id, published_video_id: ctx.published_video_id, workflow_run_id: ctx.workflow_run_id, youtube_state: { exists: true, privacy_status: v.status ? v.status.privacyStatus : null, title: v.snippet ? v.snippet.title : null, scheduled_publish_time: v.status ? (v.status.publishAt || null) : null } } }];"
      },
