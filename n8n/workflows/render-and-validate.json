      "id": "exec-13",
      "name": "Call: Get Current Scene Manifest",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2200,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const manifestRow = $input.first().json;\nconst poll = $('Call: Poll Render Job').first().json;\nconst { _ctx: c } = $('Prepare Submit Input').first().json;\nconst scenes = ((manifestRow || {}).manifest || {}).scenes || [];\nconst timelineEndMs = scenes.reduce((max, s) => Math.max(max, (s.start_ms || 0) + (s.duration_ms || 0)), 0);\nconst targetDurationSeconds = timelineEndMs > 0 ? timelineEndMs / 1000 : (poll.data.duration_seconds || 0);\nconst isPreview = c.render_type === 'preview';\nreturn [{ json: {\n  storage_path: poll.data.output_path, expected_width: isPreview ? 1280 : 1920, expected_height: isPreview ? 720 : 1080,\n  _ctx: c, _poll: poll.data, _target_duration_seconds: targetDurationSeconds\n} }];"
      },
      "id": "code-14",
      "name": "Prepare Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://renderer:3000/render/validate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ storage_path: $json.storage_path, expected_width: $json.expected_width, expected_height: $json.expected_height }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "http-15",
      "name": "Call Renderer: Validate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true,
      "onError": "continueRegularOutput",
      "position": [
        2640,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const mediaAnalysis = $input.first().json;\nconst { _ctx: c, _poll: poll, _target_duration_seconds: targetDurationSeconds } = $('Prepare Validate Input').first().json;\nreturn [{ json: {\n  channel_id: c.channel_id, workflow_run_id: c.workflow_run_id, content_project_id: c.content_project_id,\n  render_job_id: poll.render_job_id, target_duration_seconds: targetDurationSeconds, media_analysis: mediaAnalysis,\n  _ctx: c, _poll: poll\n} }];"
