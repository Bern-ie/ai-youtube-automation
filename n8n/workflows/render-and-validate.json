    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const qc = $input.first().json;\nconst { _ctx: c } = $('Prepare QC Input').first().json;\nreturn [{ json: {\n  success: false, data: null,\n  error: { code: 'RENDER_OUTPUT_INVALID', message: 'render quality control failed a hard gate: ' + (qc.data.hard_fail_reasons || []).join(', '), retryable: false, error_id: null, details: qc.data },\n  runtime: { channel_id: c.channel_id, workflow_run_id: c.workflow_run_id, content_project_id: c.content_project_id, correlation_id: null }\n} }];"
      },
      "id": "code-23",
      "name": "Build Render QC Hard-Failure Response",
      "type": "n8n-nodes-base.code",
