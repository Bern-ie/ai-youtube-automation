    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const qc = $input.first().json;\nconst { _ctx: c, _poll: poll } = $('Prepare QC Input').first().json;\nreturn [{ json: {\n  success: true,\n  data: {\n    render_job_id: poll.render_job_id, output_path: poll.output_path, output_checksum: poll.output_checksum,\n    duration_seconds: poll.duration_seconds, width_px: poll.width_px, height_px: poll.height_px, fps: poll.fps,\n    codec_details: poll.codec_details || {}, file_size_bytes: poll.file_size_bytes,\n    qc_score: qc.data.qc_score, qc_status: qc.data.qc_status, qc_details: qc.data\n  },\n  error: null,\n  runtime: { channel_id: c.channel_id, workflow_run_id: c.workflow_run_id, content_project_id: c.content_project_id, correlation_id: null }\n} }];"
      },
