        "jsCode": "const merged = $('Merge Concept With Context').first().json;\nconst goc = $('Get Or Create Thumbnail').first().json.data;\nconst fetched = $('Fetch Compose Context').first().json;\nlet imageGen = null;\ntry { const g = $('Generate Image Asset').first().json; if (g && g.success) imageGen = g.data; } catch (e) { imageGen = null; }\n\nconst durationMs = (fetched.final_video_duration_seconds || 0) * 1000;\nconst strategy = merged.source_asset_strategy;\nconst body = { channel_id: merged.channel_id, content_project_id: merged.content_project_id, thumbnail_id: goc.thumbnail_id, overlay_text: merged.overlay_text || null };\n\nif (strategy === 'generated_image' && imageGen && imageGen.b64_data) {\n  body.source_asset_strategy = 'generated_image';\n  body.generated_image_b64 = imageGen.b64_data;\n} else if ((strategy === 'existing_asset' || strategy === 'composite') && fetched.source_asset_path) {\n  body.source_asset_strategy = 'existing_asset';\n  body.source_asset_path = fetched.source_asset_path;\n} else if (strategy === 'video_frame' && fetched.final_video_storage_path) {\n  let ts = merged.source_frame_timestamp_ms;\n  if (ts == null || ts < 0 || (durationMs > 0 && ts >= durationMs)) ts = Math.min(Math.max(1000, Math.floor(durationMs * 0.3)), Math.max(0, durationMs - 200));\n  body.source_asset_strategy = 'video_frame';\n  body.final_video_storage_path = fetched.final_video_storage_path;\n  body.source_frame_timestamp_ms = ts;\n} else {\n  body.source_asset_strategy = 'brand_template';\n  const colors = merged.brand_colors || {};\n  body.brand_color = colors.primary || colors.primary_color || Object.values(colors)[0] || '#222222';\n}\nif (merged.logo_asset_path) body.logo_asset_path = merged.logo_asset_path;\nreturn [{ json: { requestBody: body, _ctx: merged, _thumbnail_id: goc.thumbnail_id, _image_gen_cost: imageGen ? imageGen.cost_usd : 0, _image_gen_provider: imageGen ? imageGen.provider : null, _image_gen_request_id: imageGen ? imageGen.request_id : null } }];"
