    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nconst ctx = $('Prepare Stock Search Input').first().json._ctx;\n// Deterministic scoring: prefer landscape orientation (16:9-ish), then\n// resolution >= 1920x1080, then raw pixel count.\nconst scored = r.data.candidates.map((c) => {\n  const landscape = c.width > c.height;\n  const hd = c.width >= 1920 && c.height >= 1080;\n  return { c, score: (landscape ? 100 : 0) + (hd ? 50 : 0) + Math.min(c.width * c.height / 10000, 40) };\n}).sort((a, b2) => b2.score - a.score);\nconst best = scored[0].c;\nconst assetId = Date.now().toString(16) + Math.random().toString(16).slice(2);\nreturn [{ json: Object.assign({ _candidate: best, _asset_id: assetId }, ctx) }];"
