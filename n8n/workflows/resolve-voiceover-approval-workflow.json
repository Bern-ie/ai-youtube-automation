{
  "name": "Resolve Voiceover Approval",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "trigger-1",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $input.first().json;\nreturn [{ json: {\n  channel_id: b.channel_id, approval_request_id: b.approval_request_id, decision: b.decision,\n  reviewer_reference: b.reviewer_reference || null, revision_instructions: b.revision_instructions || null,\n  target_chunk_ids: b.target_chunk_ids || []\n} }];"
      },
      "id": "code-2",
      "name": "Prepare Resolve Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "PLACEHOLDER:resolve-voiceover-approval.json"
        },
        "mode": "once",
        "options": {}
      },
      "id": "exec-3",
      "name": "Resolve Voiceover Approval SQL",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-4",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-5",
      "name": "Did Resolve Succeed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: $input.first().json }];"
      },
      "id": "code-6",
      "name": "Build Resolve Failure Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        900
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-7",
              "leftValue": "={{ $json.data.decision === 'revision_requested' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-8",
      "name": "Is Revision Requested?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: $input.first().json }];"
      },
      "id": "code-9",
      "name": "Build Terminal Decision Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nreturn [{ json: {\n  channel_id: r.runtime.channel_id, content_project_id: r.data.content_project_id,\n  idempotency_key: 'voiceover-revision:' + r.data.content_project_id + ':' + Date.now(),\n  correlation_id: r.runtime.correlation_id,\n  force_regenerate_chunk_ids: r.data.target_chunk_ids || [],\n  revision_trigger: 'human_revision_request', revision_reason: r.data.revision_instructions\n} }];"
      },
      "id": "code-10",
      "name": "Prepare Revision Voiceover-Project Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "PLACEHOLDER:voiceover-project.json"
        },
        "mode": "once",
        "options": {}
      },
      "id": "exec-11",
      "name": "Resume: Voiceover Project",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1760,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const resolveResult = $('Did Resolve Succeed?').first().json;\nconst resumed = $input.first().json;\nreturn [{ json: { success: true, data: { decision: 'revision_requested', resolved: resolveResult.data, resumed_voiceover_project: resumed }, error: null, runtime: resolveResult.runtime } }];"
      },
      "id": "code-12",
      "name": "Build Revision Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ]
    }
  ],
