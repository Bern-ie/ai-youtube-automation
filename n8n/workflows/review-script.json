    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const prompt = $json.data;\nconst ctx = $('Prepare Get-Prompt Input').first().json._ctx;\nconst det = $('Script Deterministic QC').first().json.data;\nconst model = (prompt.model_compatibility && prompt.model_compatibility[0]) || 'claude-opus-4-8';\nconst userPayload = {\n  script: ctx.content, narration_text: ctx.narration_text, research_package: ctx.research_package,\n  channel: { script_tone: ctx.script_tone || null, target_audience: ctx.target_audience || null, cta_type: ctx.cta_type || null },\n  target_duration_seconds: ctx.target_duration_seconds || null, deterministic_metrics: det\n};\nconst schema = {\"type\":\"object\",\"additionalProperties\":false,\"required\":[\"overall_score\",\"dimension_scores\",\"unsupported_claims\",\"misleading_statements\",\"hard_fail\",\"hard_fail_reasons\",\"feedback\"],\"properties\":{\"overall_score\":{\"type\":\"number\"},\"dimension_scores\":{\"type\":\"object\",\"description\":\"0-10 per dimension — informs overall_score but does not itself gate pass/revise/fail (that's overall_score + hard_fail).\",\"additionalProperties\":false,\"required\":[\"factual_grounding\",\"source_coverage\",\"hook_quality\",\"first_30_seconds_strength\",\"pacing\",\"clarity\",\"repetition_and_filler\",\"transitions\",\"retention_structure\",\"clickbait_restraint\",\"tone_fit\",\"audience_fit\",\"cta_fit\",\"runtime_fit\",\"brand_safety\"],\"properties\":{\"factual_grounding\":{\"type\":\"number\"},\"source_coverage\":{\"type\":\"number\"},\"hook_quality\":{\"type\":\"number\"},\"first_30_seconds_strength\":{\"type\":\"number\"},\"pacing\":{\"type\":\"number\"},\"clarity\":{\"type\":\"number\"},\"repetition_and_filler\":{\"type\":\"number\"},\"transitions\":{\"type\":\"number\"},\"retention_structure\":{\"type\":\"number\"},\"clickbait_restraint\":{\"type\":\"number\"},\"tone_fit\":{\"type\":\"number\"},\"audience_fit\":{\"type\":\"number\"},\"cta_fit\":{\"type\":\"number\"},\"runtime_fit\":{\"type\":\"number\"},\"brand_safety\":{\"type\":\"number\"}}},\"unsupported_claims\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"Narration excerpts the reviewer judges factual but inadequately grounded, beyond what the deterministic reference-presence check alone can catch.\"},\"misleading_statements\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"pronunciation_concerns\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"youtube_policy_concerns\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"hard_fail\":{\"type\":\"boolean\",\"description\":\"true only for severe plagiarism/copyright risk or a severe platform-policy concern — never set for a merely low score.\"},\"hard_fail_reasons\":{\"type\":\"array\",\"items\":{\"type\":\"string\"}},\"feedback\":{\"type\":\"string\",\"description\":\"Concrete, actionable notes — this is the primary input to the revision prompt when status is revision_needed.\"}}};\nreturn [{ json: {\n  ctx, model,\n  requestBody: {\n    model, max_tokens: 4096,\n    system: prompt.content,\n    messages: [{ role: 'user', content: JSON.stringify(userPayload) }],\n    output_config: { format: { type: 'json_schema', schema } }\n  }\n} }];"
