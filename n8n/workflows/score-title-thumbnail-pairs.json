        "query": "SELECT t.id AS thumbnail_id, t.variant_number, tc.visual_idea, tc.overlay_text, tc.focal_subject FROM thumbnails t JOIN thumbnail_concepts tc ON tc.id = t.thumbnail_concept_id WHERE t.publication_package_id = $1 AND t.status = 'completed' ORDER BY t.variant_number;",
