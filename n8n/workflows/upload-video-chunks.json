        "jsCode": "const r = $('Prepare Record-Video-Id Input').first().json;\nreturn [{ json: { success: true, data: { youtube_video_id: r.youtube_video_id, youtube_url: r.youtube_url, already_uploaded: false }, error: null, runtime: { channel_id: r.channel_id, workflow_run_id: $('Normalize Loop Input').first().json.workflow_run_id, content_project_id: $('Normalize Loop Input').first().json.content_project_id, correlation_id: $('Normalize Loop Input').first().json.correlation_id ?? null } } }];"
      },
      "id": "code-19",
      "name": "Build Upload-Complete Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3520,
        -320
