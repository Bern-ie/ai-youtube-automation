        "jsCode": "const c = $('Normalize Loop Input').first().json;\nconst r = $input.first().json;\nreturn [{ json: { channel_id: c.channel_id, published_video_id: c.published_video_id, bytes_uploaded: r.bytes_uploaded, last_provider_response: r.provider_response || {}, new_attempt: false } }];"
      },
