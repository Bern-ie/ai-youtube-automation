    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const c = $('Normalize Loop Input').first().json;\nconst r = $('Parse Chunk Response').first().json;\nreturn [{ json: Object.assign({}, c, { bytes_uploaded: r.bytes_uploaded }) }];"
      },
      "id": "code-20",
      "name": "Prepare Next Iteration Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
