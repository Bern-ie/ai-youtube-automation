{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-youtube-automation.internal/claim-extraction.schema.json",
  "title": "Claim Extraction Output",
  "description": "Structured output of the claim-extraction LLM call, validated before being passed to create_research_claims_batch(). Every source_id cited here must be a source_id already returned by collect_research_sources() for this project — invented IDs are rejected by the research_claim_sources foreign key, not trusted from the LLM. See docs/architecture/research-pipeline.md#claim-extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_text", "classification", "confidence", "time_sensitive"],
        "properties": {
          "claim_text": {
            "type": "string",
            "minLength": 1,
            "description": "One atomic, independently verifiable claim — not a vague generalization."
          },
          "classification": {
            "type": "string",
            "enum": ["verified_fact", "likely_fact", "opinion", "inference", "unverified_claim", "time_sensitive_claim"]
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "time_sensitive": { "type": "boolean" },
          "supporting_source_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
          "contradicting_source_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
          "contextualizing_source_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } }
        }
      }
    }
  }
}
