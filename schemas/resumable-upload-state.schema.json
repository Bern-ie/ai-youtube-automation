{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-youtube-automation.internal/resumable-upload-state.schema.json",
  "title": "Resumable Upload State",
  "description": "Persisted resumable-upload progress (published_videos.upload_session_uri/bytes_uploaded/total_bytes/upload_attempt) — never a bearer token. See docs/architecture/youtube-publication-pipeline.md#resumable-upload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["published_video_id", "bytes_uploaded"],
  "properties": {
    "published_video_id": { "type": "string", "format": "uuid" },
    "upload_session_uri": { "type": ["string", "null"] },
    "bytes_uploaded": { "type": "integer", "minimum": 0 },
    "total_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "upload_attempt": { "type": "integer", "minimum": 1 }
  }
}
