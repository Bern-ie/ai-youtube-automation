{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-youtube-automation.internal/scene-manifest.schema.json",
  "title": "Scene Manifest",
  "description": "The deterministic, versioned render specification built by build_scene_manifest() and validated by validate_scene_manifest() before any FFmpeg call. This is the `manifest` JSONB body stored on `scene_manifests.manifest` — never mutated once persisted; a revision always creates a new version. See docs/architecture/video-render-pipeline.md#scene-manifest.",
  "type": "object",
  "additionalProperties": true,
  "required": ["manifest_version", "channel_id", "content_project_id", "output", "audio", "scenes"],
  "properties": {
    "manifest_version": { "const": 1 },
    "channel_id": { "type": "string", "format": "uuid" },
    "content_project_id": { "type": "string", "format": "uuid" },
    "script_version_id": { "type": ["string", "null"], "format": "uuid" },
    "voiceover_id": { "type": ["string", "null"], "format": "uuid" },
    "shot_list_id": { "type": ["string", "null"], "format": "uuid" },
    "output": {
      "type": "object",
      "properties": {
        "container": { "const": "mp4" },
        "video_codec": { "const": "h264" },
        "audio_codec": { "const": "aac" },
        "width": { "const": 1920 },
        "height": { "const": 1080 },
        "fps": { "type": "integer", "minimum": 1 },
        "pixel_format": { "const": "yuv420p" }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "narration_path": { "type": ["string", "null"] },
        "background_music_path": { "type": ["string", "null"] },
        "loudness_target_lufs": { "type": "number" }
      }
    },
    "branding": { "type": "object" },
    "captions": {
      "type": "object",
      "properties": {
        "srt_path": { "type": ["string", "null"] },
        "vtt_path": { "type": ["string", "null"] },
        "burn_in": { "type": "boolean" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": true,
      "required": ["scene_id", "shot_id", "sequence", "start_ms", "end_ms", "duration_ms", "asset_type"],
      "properties": {
        "scene_id": { "type": "string" },
        "shot_id": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer" },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "asset_id": { "type": ["string", "null"], "format": "uuid" },
        "asset_path": { "type": ["string", "null"] },
        "asset_checksum": { "type": ["string", "null"] },
        "asset_type": {
          "type": "string",
          "enum": [
            "stock_video", "stock_image", "generated_image", "generated_video", "screenshot",
            "chart", "map", "motion_graphic", "text_animation", "public_domain_archive", "brand_asset"
          ]
        },
        "source_width": { "type": ["integer", "null"] },
        "source_height": { "type": ["integer", "null"] },
        "source_duration_ms": { "type": ["integer", "null"] },
        "crop_mode": { "type": "string", "enum": ["contain", "cover"] },
        "motion_plan": { "type": "object" },
        "overlay_text": { "type": ["string", "null"] },
        "overlay_style": { "type": "object" },
        "transition_in": { "type": "string", "enum": ["cut", "dissolve", "fade", "zoom", "match_cut", "none"] },
        "transition_out": { "type": "string", "enum": ["cut", "dissolve", "fade", "zoom", "match_cut", "none"] },
        "attribution": {
          "type": "object",
          "properties": { "required": { "type": "boolean" }, "text": { "type": ["string", "null"] } }
        },
        "source_ids": { "type": "array" },
        "claim_ids": { "type": "array" }
      }
    }
  }
}
