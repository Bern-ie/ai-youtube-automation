{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-youtube-automation.internal/strategy-insight.schema.json",
  "title": "Strategy Insight",
  "description": "The persisted shape returned by create_strategy_insight()/activate_strategy_insight()/reject_strategy_insight(). See strategy_insights in database/schema.sql and docs/architecture/analytics-strategy-pipeline.md#strategy-insights.",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "channel_id", "insight_type", "insight_kind", "recommendation", "sample_size", "status"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "channel_id": { "type": "string", "format": "uuid" },
    "insight_type": { "type": "string", "enum": ["topic_selection", "hook_structure", "first_30_second_pacing", "video_duration", "section_pacing", "cta_placement", "thumbnail_style", "title_style", "publishing_schedule", "visual_treatment", "chapter_structure", "traffic_targeting"] },
    "insight_kind": { "type": "string", "enum": ["observation", "recommendation"] },
    "subject": { "type": ["string", "null"] },
    "observation": { "type": ["string", "null"] },
    "recommendation": { "type": "string" },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "confidence_label": { "type": ["string", "null"], "enum": ["exploratory", "low", "moderate", "high", null] },
    "sample_size": { "type": "integer", "minimum": 0 },
    "metric_basis": { "type": ["string", "null"] },
    "limitations": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["draft", "pending_review", "active", "rejected", "expired", "superseded"] },
    "effective_from": { "type": ["string", "null"], "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "superseded_at": { "type": ["string", "null"], "format": "date-time" },
    "superseded_by_insight_id": { "type": ["string", "null"], "format": "uuid" },
    "rejected_reason": { "type": ["string", "null"] },
    "is_test_data": { "type": "boolean" },
    "methodology_version": { "type": "integer", "minimum": 1 },
    "prompt_id": { "type": ["string", "null"], "format": "uuid" },
    "prompt_version_id": { "type": ["string", "null"], "format": "uuid" },
    "model_used": { "type": ["string", "null"] }
  }
}
